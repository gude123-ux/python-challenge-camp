{
  "name": "python-challenge-camp",
  "displayName": "Python闯关训练营",
  "description": "面向的 Python 学习闯关系统：每日任务派发、关卡解锁、AI 自动批改、进度追踪，全部数据保存在本地工作区。",
  "version": "1.5.0",
  "publisher": "gude123-ux",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Education",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "python",
    "学习",
    "闯关",
    "教育",
    "AI批改",
    ""
  ],
  "icon": "media/icon.png",
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onView:pythonCamp.sidebar",
    "onLanguage:python"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "pythonCampActivity",
          "title": "Python闯关训练营",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "pythonCampActivity": [
        {
          "id": "pythonCamp.sidebar",
          "name": "闯关进度",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "pythonCamp.openPanel",
        "title": "打开进度面板",
        "category": "Python闯关训练营",
        "icon": "$(dashboard)"
      },
      {
        "command": "pythonCamp.startToday",
        "title": "开始今日任务",
        "category": "Python闯关训练营",
        "icon": "$(calendar)"
      },
      {
        "command": "pythonCamp.pickLevel",
        "title": "选择关卡（含手动切换）",
        "category": "Python闯关训练营",
        "icon": "$(list-ordered)"
      },
      {
        "command": "pythonCamp.startLevel",
        "title": "打开当前关卡详情",
        "category": "Python闯关训练营",
        "icon": "$(book)"
      },
      {
        "command": "pythonCamp.submitAndGrade",
        "title": "提交并批改当前文件",
        "category": "Python闯关训练营",
        "icon": "$(check)"
      },
      {
        "command": "pythonCamp.runCurrentFile",
        "title": "本地运行当前文件",
        "category": "Python闯关训练营",
        "icon": "$(play)"
      },
      {
        "command": "pythonCamp.retryWrong",
        "title": "重刷错题关卡",
        "category": "Python闯关训练营",
        "icon": "$(refresh)"
      },
      {
        "command": "pythonCamp.resetToday",
        "title": "重置今日任务",
        "category": "Python闯关训练营",
        "icon": "$(history)"
      },
      {
        "command": "pythonCamp.submitPending",
        "title": "补交批改（写了代码还没提交的关卡）",
        "category": "Python闯关训练营",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "pythonCamp.exportReport",
        "title": "导出学习报告（Markdown）",
        "category": "Python闯关训练营",
        "icon": "$(export)"
      },
      {
        "command": "pythonCamp.openConfig",
        "title": "配置 API Key 与模型",
        "category": "Python闯关训练营",
        "icon": "$(settings-gear)"
      },
      {
        "command": "pythonCamp.testConnection",
        "title": "测试 AI 连接",
        "category": "Python闯关训练营",
        "icon": "$(plug)"
      },
      {
        "command": "pythonCamp.explainLevel",
        "title": "AI 讲解本关（含参考答案）",
        "category": "Python闯关训练营",
        "icon": "$(lightbulb)"
      },
      {
        "command": "pythonCamp.multipleSolutions",
        "title": "AI 列出多种解法",
        "category": "Python闯关训练营",
        "icon": "$(list-tree)"
      },
      {
        "command": "pythonCamp.diagnoseError",
        "title": "AI 分析报错原因",
        "category": "Python闯关训练营",
        "icon": "$(bug)"
      },
      {
        "command": "pythonCamp.askQuestion",
        "title": "问 AI 助教（随时提问）",
        "category": "Python闯关训练营",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "pythonCamp.resetAll",
        "title": "重置全部进度（危险）",
        "category": "Python闯关训练营",
        "icon": "$(trash)"
      }
    ],
    "keybindings": [
      {
        "command": "pythonCamp.submitAndGrade",
        "key": "ctrl+alt+g",
        "mac": "cmd+alt+g",
        "when": "editorLangId == python"
      },
      {
        "command": "pythonCamp.runCurrentFile",
        "key": "ctrl+alt+r",
        "mac": "cmd+alt+r",
        "when": "editorLangId == python"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "pythonCamp.startToday",
          "when": "view == pythonCamp.sidebar",
          "group": "navigation@1"
        },
        {
          "command": "pythonCamp.openConfig",
          "when": "view == pythonCamp.sidebar",
          "group": "navigation@2"
        }
      ],
      "editor/context": [
        {
          "command": "pythonCamp.submitAndGrade",
          "when": "editorLangId == python",
          "group": "pythonCamp@1"
        },
        {
          "command": "pythonCamp.runCurrentFile",
          "when": "editorLangId == python",
          "group": "pythonCamp@2"
        }
      ],
      "commandPalette": [
        {
          "command": "pythonCamp.startLevel",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Python闯关训练营",
      "properties": {
        "pythonCamp.apiKey": {
          "type": "string",
          "default": "",
          "markdownDescription": "大模型 API Key。留空则只做本地运行检查，不做 AI 批改。\n\n**仅代码片段会发送给模型，不会上传整个工作区。**",
          "order": 1
        },
        "pythonCamp.apiBaseUrl": {
          "type": "string",
          "default": "https://api.deepseek.com/v1",
          "markdownDescription": "模型服务地址（OpenAI 兼容的 `/chat/completions` 接口）。\n\n例如：`https://api.deepseek.com/v1`、`https://api.openai.com/v1`、`http://127.0.0.1:9208/v1`",
          "order": 2
        },
        "pythonCamp.model": {
          "type": "string",
          "default": "deepseek-chat",
          "description": "模型名称，例如 deepseek-chat / gpt-4o-mini / qwen-plus。",
          "order": 3
        },
        "pythonCamp.enableAI": {
          "type": "boolean",
          "default": true,
          "description": "是否开启 AI 批改。关闭后只做本地语法检查与运行检查。",
          "order": 4
        },
        "pythonCamp.passLine": {
          "type": "number",
          "default": 60,
          "minimum": 0,
          "maximum": 100,
          "description": "过关分数线（0-100）。达到该分数即解锁下一关。（1.2.0 起由 passScore 改名而来，避免与另一个同名插件的配置键撞车）",
          "order": 5
        },
        "pythonCamp.dailyTaskCount": {
          "type": "number",
          "default": 3,
          "minimum": 1,
          "maximum": 10,
          "description": "每天自动派发的任务数量。",
          "order": 6
        },
        "pythonCamp.allowSkipLevels": {
          "type": "boolean",
          "default": false,
          "description": "允许跳关。开启后可以在关卡地图里直接进入未解锁的关卡。",
          "order": 7
        },
        "pythonCamp.pythonPath": {
          "type": "string",
          "default": "python",
          "description": "Python 解释器路径。留空或填 python 则使用 PATH 中的 python。",
          "order": 8
        },
        "pythonCamp.autoRunBeforeGrade": {
          "type": "boolean",
          "default": true,
          "description": "提交批改前先本地运行一次代码，把真实的报错/输出一起交给 AI 判分。建议保持开启。",
          "order": 9
        },
        "pythonCamp.runTimeoutSec": {
          "type": "number",
          "default": 20,
          "minimum": 3,
          "maximum": 120,
          "description": "本地运行代码的超时时间（秒）。",
          "order": 10
        },
        "pythonCamp.trackStudyTime": {
          "type": "boolean",
          "default": true,
          "description": "统计学习时长（VS Code 处于前台且有编辑器活动时计时）。",
          "order": 11
        },
        "pythonCamp.strictMode": {
          "type": "boolean",
          "default": false,
          "description": "严格模式：AI 批改评分标准更严，代码质量占比更高。",
          "order": 12
        },
        "pythonCamp.maxTokens": {
          "type": "number",
          "default": 4000,
          "minimum": 500,
          "maximum": 32000,
          "description": "单次调用允许模型输出的最大 token 数。如果提示「输出被截断 / JSON 不完整」，把这里调大（比如 8000）。",
          "order": 13
        },
        "pythonCamp.aiTimeoutSec": {
          "type": "number",
          "default": 120,
          "minimum": 20,
          "maximum": 900,
          "description": "模型响应超时（秒）。推理模型（gpt-5.x、deepseek-reasoner 等）思考较慢，建议 180~300。",
          "order": 14
        },
        "pythonCamp.retryOnBadJson": {
          "type": "boolean",
          "default": true,
          "description": "模型返回的 JSON 结构损坏时自动重试一次。第三方中转偶发把两次生成拼接在一起，重试通常能拿到干净结果（代价是多等一次）。",
          "order": 15
        },
        "pythonCamp.autoDiagnoseOnError": {
          "type": "boolean",
          "default": true,
          "description": "本地运行失败后自动让 AI 分析报错原因，结果显示在关卡详情页。关闭后只能手动点「AI 分析报错」。",
          "order": 16
        },
        "pythonCamp.terminalContext": {
          "type": "boolean",
          "default": true,
          "description": "把集成终端里**与 Python 相关**的命令与输出作为批改 / 报错分析 / 答疑的证据（需要 VS Code 1.93+）。\n\n课程材料里有些练习要求在终端敲命令观察结果，关掉它会让 AI 误判这些练习没做。\n只有 python / pip / conda 等命令会被记录，其它命令（git、ssh…）连输出都不会读取。",
          "order": 17
        }
      }
    }
  },
  "scripts": {
    "launch": "node scripts/launch.js",
    "launch:install": "node scripts/launch.js --install",
    "launch:check": "node scripts/launch.js --check",
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && npm run compile && npm run test:smoke && npm run test:load",
    "test:smoke": "node scripts/smoke.build.js && node out-smoke/smoke.js",
    "test:load": "node scripts/loadtest.js",
    "package": "npx --yes @vscode/vsce package --no-dependencies --allow-missing-repository",
    "vscode:prepublish": "node esbuild.js --production"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.24.2",
    "typescript": "^5.7.2"
  }
}
